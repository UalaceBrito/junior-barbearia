# Copie para .env.local; nunca coloque segredos em NEXT_PUBLIC_*.

# Banco Supabase (somente no servidor): URL do projeto e chave service_role.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# O agente só agenda após chamar a ferramenta de reserva no servidor.
OPENAI_API_KEY=
OPENAI_BOOKING_MODEL=gpt-4o-mini

# Horários provisórios: confirmar com a barbearia antes de aceitar reservas reais.
BOOKING_TIME_ZONE=America/Sao_Paulo
BOOKING_OPENING_TIME=09:00
BOOKING_CLOSING_TIME=18:00
BOOKING_SLOT_MINUTES=30
